# ===== X (Twitter) API =====
# https://developer.x.com/en/portal/dashboard
# App permissions を Read and Write にしたうえで、
# Access Token / Secret は必ず「権限変更後に」再生成すること。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ===== Anthropic =====
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== Upstash Redis =====
# Vercel の Marketplace から Upstash を接続すると自動で入る
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== 認証 =====
# Vercel の cron は CRON_SECRET を Authorization ヘッダに自動付与する。
# openssl rand -hex 32 などで生成すること。
CRON_SECRET=
# 管理画面(/admin)のパスワード。未設定なら CRON_SECRET を代用するが、分けるのを推奨。
ADMIN_SECRET=

# ===== 任意の調整項目（未設定ならコード内の既定値）=====
# 1日の投稿上限。X Free プランは24時間で17件程度が上限なので余裕を持たせる
MAX_DAILY_POSTS=12
# 連投防止の最小間隔（分）
MIN_POST_GAP_MINUTES=5
# 配信から何時間以内の記事を扱うか
MAX_ARTICLE_AGE_HOURS=72
# 使用するClaudeモデル
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ===== Instagram 同時投稿（任意。未設定ならIG投稿は完全に休眠しXのみ動作）=====
# Instagram API with Instagram Login のトークンとアカウントID。
# 未設定なら instagramConfigured()=false となり、投稿経路はXだけになる。
# トークンは60日で失効するが、週次 cron /api/ig/refresh が延命し新値をRedisに保存する。
# トークンを手動で再発行したら IG_ACCESS_TOKEN を更新し、/api/ig/refresh?seed=1 を一度叩く。
IG_USER_ID=
IG_ACCESS_TOKEN=
# 省略可。Graph APIのバージョン（既定 v21.0）
# IG_GRAPH_VERSION=v21.0
# 省略可。IG投稿画像の最適化モード（既定 square）
#   square=1:1中央クロップ / portrait=4:5中央クロップ / auto=範囲外だけ最小クロップ / pad=全体を残しぼかし背景で余白
# IG_IMAGE_MODE=square
# 省略可。自分の公開URL。未設定なら Vercel の VERCEL_PROJECT_PRODUCTION_URL を自動使用
# PUBLIC_BASE_URL=https://ice-cream-bot.vercel.app
