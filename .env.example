# ===== X (Twitter) API =====
# https://developer.x.com/en/portal/dashboard
# App permissions を Read and Write にしたうえで、
# Access Token / Secret は必ず「権限変更後に」再生成すること。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ===== Anthropic =====
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== Upstash Redis =====
# Vercel の Marketplace から Upstash を接続すると自動で入る
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== 認証 =====
# Vercel の cron は CRON_SECRET を Authorization ヘッダに自動付与する。
# openssl rand -hex 32 などで生成すること。
CRON_SECRET=
# 管理画面(/admin)のパスワード。未設定なら CRON_SECRET を代用するが、分けるのを推奨。
ADMIN_SECRET=

# ===== 任意の調整項目（未設定ならコード内の既定値）=====
# 1日の投稿上限。X Free プランは24時間で17件程度が上限なので余裕を持たせる
MAX_DAILY_POSTS=12
# 連投防止の最小間隔（分）
MIN_POST_GAP_MINUTES=5
# 配信から何時間以内の記事を扱うか
MAX_ARTICLE_AGE_HOURS=72
# 使用するClaudeモデル
CLAUDE_MODEL=claude-haiku-4-5-20251001
